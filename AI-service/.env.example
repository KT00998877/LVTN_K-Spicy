# Google Gemini API
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model for chat (gemini-3.8-flash recommended for speed/cost balance)
GEMINI_CHAT_MODEL=gemini-3.8-flash

# AI Service Security - Internal token for Laravel authentication
# Generate a secure random key: openssl rand -hex 32
AI_SERVICE_INTERNAL_KEY=

# FastAPI Server
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8001

# Gemini Configuration
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=1024
CHAT_TIMEOUT_SECONDS=70

# Business API; Vite sends chatbot requests to a separate Laravel process :8002.
LARAVEL_API_URL=http://127.0.0.1:8000
LARAVEL_API_TIMEOUT=8

# Logging
LOG_LEVEL=INFO

# Model failover chain. Gemini free-tier quota is counted PER MODEL, so an
# exhausted primary model (429 RESOURCE_EXHAUSTED) must fall over to another
# model rather than take the chatbot offline. The chain is tried in order for
# 429 (quota), 404 (retired model id) and 5xx (upstream overload).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
