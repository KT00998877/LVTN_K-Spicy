# Copy to .env before running Flutter. Public client configuration only.
BASE_URL_WEB=http://127.0.0.1:8000/api
# Replace with the LAN host reachable from your phone.
BASE_URL_MOBILE=http://YOUR_LAN_HOST:8000/api
# Android Emulator: http://10.0.2.2:8000/api
# Physical device: http://<backend-computer-LAN-IP>:8000/api

# Chatbot base URL (optional).
#
# The chatbot must NOT run on the same Laravel process as the business API.
# `php artisan serve` handles one request at a time, so a chat request waiting
# on the AI Service blocks the AI Service's own callback to /api/menu and the
# two deadlock (measured on mobile: 3 of 4 questions failed with 503 after
# ~20s; on a separate chat gateway: 0 of 4 failed, median 3.0s).
#
# `scripts/dev_chatbot.py` starts that second process on port 8002. Leave this
# unset to let the app derive it from the business URL above.
# BASE_URL_CHAT_WEB=http://127.0.0.1:8002/api
# BASE_URL_CHAT_MOBILE=http://YOUR_LAN_HOST:8002/api
#
# In production behind nginx/php-fpm (many workers, no deadlock) it is fine to
# point both at the same host.
