APP_NAME="Mì Cay Hàn Quốc - Korean Spice House"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# To enable staff WebSocket notifications, set BROADCAST_CONNECTION=reverb.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RESTAURANT_LATITUDE=10.0308
RESTAURANT_LONGITUDE=105.7689
FRONTEND_URL=http://localhost:5173
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Browser return URL; web and mobile can use separate development hosts.
VNP_RETURN_URL=http://localhost:8000/api/payments/vnpay/return
VNPAY_RETURN_URL_WEB=http://localhost:8000/api/payments/vnpay/return
# Set the LAN host reachable from your physical phone.
VNPAY_RETURN_URL_MOBILE=

# IPN must be reachable by VNPay over the public internet.
# Register a public HTTPS endpoint in the merchant portal; leave empty for local development.
VNP_IPN_URL=
VNP_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Public IPv4 of this server, used as vnp_IpAddr on querydr. Never a private range.
VNP_SERVER_IP=


AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_COPY_ENABLED=true
AI_IMAGE_ENABLED=true
AI_RATE_LIMIT_PER_HOUR=100
AI_CACHE_TTL=86400

# Phase 13 — RAG (embed + truy hồi)
# COHERE_API_KEY: https://dashboard.cohere.com -> API Keys -> Create Trial Key
COHERE_API_KEY=
RAG_EMBED_PROVIDER=cohere
RAG_EMBED_MODEL=embed-multilingual-v3.0
RAG_OUTPUT_DIR=../AI/knowledge_base
# Chỉ cần khi máy không có CA bundle mặc định (Windows thường cần).
# Client tự dò; đặt tường minh nếu muốn chỉ định:
# RAG_CA_BUNDLE=C:\Program Files\Git\mingw64\etc\ssl\certs\ca-bundle.crt